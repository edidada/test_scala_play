# ECShop Play REST API — full URL skeleton (docs/02_url_api_list.md, docs/03_api_contract.md).
# Every line maps a PHP entry point to its JSON/REST endpoint. Bodies are implemented
# one URL at a time; the completion state is tracked in docs/09_url_completion_matrix.md.

# --- M0: operations --------------------------------------------------------
GET     /healthz                                    controllers.HealthController.healthz

# --- M1: browse the catalog ------------------------------------------------
GET     /api/v1/home                                controllers.HomeController.home
GET     /api/v1/catalog                             controllers.CatalogController.catalog
GET     /api/v1/brands                              controllers.CatalogController.brands(page: Option[Int], page_size: Option[Int])
GET     /api/v1/brands/:id/goods                    controllers.CatalogController.brandGoods(id: Long, page: Option[Int], page_size: Option[Int], sort: Option[String])
GET     /api/v1/categories/:id/goods                controllers.CategoryController.goods(id: Long, page: Option[Int], page_size: Option[Int], sort: Option[String])
GET     /api/v1/goods                               controllers.GoodsController.list(page: Option[Int], page_size: Option[Int], category_id: Option[Int], brand_id: Option[Int], q: Option[String], sort: Option[String])
GET     /api/v1/goods/:id                           controllers.GoodsController.detail(id: Long)
POST    /api/v1/goods/:id/price-quote               controllers.GoodsController.priceQuote(id: Long)
GET     /api/v1/goods/:id/gallery                   controllers.GoodsController.gallery(id: Long)
GET     /api/v1/compare                             controllers.GoodsController.compare(goods_ids: Option[String])
GET     /api/v1/quotation                           controllers.GoodsController.quotation(page: Option[Int], page_size: Option[Int], category_id: Option[Int], brand_id: Option[Int], q: Option[String])
GET     /api/v1/regions                             controllers.RegionController.list(parent: Option[Long])

# --- M1: content ----------------------------------------------------------
GET     /api/v1/articles/:id                        controllers.ArticleController.detail(id: Long)
GET     /api/v1/article-categories/:id/articles     controllers.ArticleController.categoryArticles(id: Long, page: Option[Int], page_size: Option[Int])
GET     /sitemap.xml                                controllers.FeedController.sitemap
GET     /feed.xml                                   controllers.FeedController.feed
GET     /goods-widget.js                            controllers.WidgetController.goodsWidget(cat_id: Option[Long], brand_id: Option[Long], goods_num: Option[Int], intro_type: Option[String])
GET     /cycle-image.xml                            controllers.AdController.cycleImage

